# Utilisé par docker-compose pour le conteneur PostgreSQL et pour construire
# la DATABASE_URL injectée dans le conteneur api.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=restaurant
POSTGRES_PORT=5432

# Ports exposés sur la machine hôte
API_PORT=3001
WEB_PORT=5173

# Origine autorisée par le CORS de l'API
WEB_ORIGIN=http://localhost:5173

# JWT (authentification) — génère une valeur avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-every-environment
JWT_EXPIRES_IN=8h
