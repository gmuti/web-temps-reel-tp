# À utiliser pour lancer l'API en dehors de Docker (npm run start:dev).
# Doit correspondre aux identifiants du service postgres de docker-compose.yml
# si la base tourne dans un conteneur.
DATABASE_URL="postgresql://app:app@localhost:5432/restaurant?schema=public"
PORT=3001
WEB_ORIGIN=http://localhost:5173

# Génère une valeur avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-every-environment
JWT_EXPIRES_IN=8h
