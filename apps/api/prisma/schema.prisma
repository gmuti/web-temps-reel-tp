generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Les valeurs correspondent aux schémas Zod de shared/src/role.ts et order.ts —
// toute modification doit être répercutée des deux côtés.
enum UserRole {
  RESPONSABLE
  MANAGER
  WAITER
  COOK
}

enum OrderStatus {
  A_VALIDER
  VALIDEE
  EN_PREPARATION
  PRETE
  SERVIE
  ANNULEE
}

model Restaurant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users       User[]
  orders      Order[]
  messages    Message[]
  dishes      Dish[]
  orderEvents OrderEvent[]
  tables      DiningTable[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  restaurantId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])
  orders     Order[]     @relation("OrderWaiter")
  messages   Message[]

  @@index([restaurantId])
}

model Order {
  id            String      @id @default(uuid())
  restaurantId  String
  tableNumber   Int
  status        OrderStatus @default(A_VALIDER)
  comment       String?
  // Idempotence : rejouer une création avec le même clientOrderId ne doit
  // jamais produire une seconde commande (cf. sujet, séance 1).
  clientOrderId String?     @unique
  waiterId      String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id])
  waiter     User         @relation("OrderWaiter", fields: [waiterId], references: [id])
  items      OrderItem[]
  events     OrderEvent[]

  @@index([restaurantId, status])
}

model OrderItem {
  id       String  @id @default(uuid())
  orderId  String
  // Plat de la carte. Nom et prix sont recopiés (`meal`, `price`) : la commande
  // reste lisible même si la carte change. Null pour les commandes antérieures
  // au catalogue.
  dishId   String?
  meal     String
  quantity Int
  // Prix unitaire au moment de la commande (indépendant d'un futur prix de
  // carte) — Decimal pour éviter les erreurs d'arrondi des flottants.
  price    Decimal @db.Decimal(10, 2)
  // Contrainte libre sur ce plat ("sans oignon"...).
  note     String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish  Dish? @relation(fields: [dishId], references: [id])

  @@index([orderId])
}

// Carte du restaurant.
model Dish {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  price        Decimal  @db.Decimal(10, 2)
  // Chemin d'une image servie par le front (ex. "/dishes/burger.svg").
  imageUrl     String
  createdAt    DateTime @default(now())

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])
  orderItems OrderItem[]

  @@unique([restaurantId, name])
}

// Valeurs alignées sur tableShapeSchema (shared/src/floor.ts).
enum TableShape {
  small
  long
}

// Valeurs alignées sur tableStatusSchema (shared/src/floor.ts).
enum TableStatus {
  LIBRE
  OCCUPEE
  A_DEBARRASSER
}

// Table du plan de salle. `Order.tableNumber` reste un numéro (pas de clé
// étrangère) : les commandes existantes et le contrat d'API ne changent pas ;
// si le restaurant a un plan, le numéro est vérifié à la création.
model DiningTable {
  id              String      @id @default(uuid())
  restaurantId    String
  number          Int
  // Position au sol en mètres, origine au centre de la salle (cf. shared/src/floor.ts).
  x               Float
  z               Float
  shape           TableShape
  seats           Int
  // Occupation (cf. shared/src/floor.ts). `version` augmente à chaque changement :
  // les clients gardent l'état le plus récent, quel que soit l'ordre d'arrivée.
  status          TableStatus @default(LIBRE)
  guests          Int?
  statusChangedAt DateTime    @default(now())
  version         Int         @default(0)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, number])
}

// Journal des événements publiés sur les commandes : l'identifiant croissant sert
// de curseur pour rattraper les événements manqués après une coupure.
model OrderEvent {
  id           Int      @id @default(autoincrement())
  restaurantId String
  orderId      String
  // Serveur de la commande : permet de ne rejouer à un serveur que ses commandes.
  waiterId     String
  // "order:created" ou "order:status-updated" (cf. shared/src/realtime.ts).
  type         String
  // Données de l'événement publié, sans son identifiant.
  payload      Json
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  order      Order      @relation(fields: [orderId], references: [id])

  @@index([restaurantId, id])
}

model Message {
  id              String   @id @default(uuid())
  restaurantId    String
  // "general", "kitchen", "service" ou "order:<orderId>" (cf. shared/src/chat.ts).
  channelId       String
  authorId        String
  content         String
  // Idempotence : un message renvoyé après une reconnexion n'est pas dupliqué.
  clientMessageId String   @unique
  createdAt       DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  author     User       @relation(fields: [authorId], references: [id])

  @@index([restaurantId, channelId, createdAt])
}
